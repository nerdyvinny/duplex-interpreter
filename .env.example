# Copy to .env and fill in. .env is gitignored.

# Required for the default cloud path (STT + translation + TTS all use this one key).
OPENAI_API_KEY=sk-...

# Optional: better translation for European language pairs. Free tier = 500k chars/month.
# Get one at https://www.deepl.com/pro-api  -> set providers.translation: deepl
# DEEPL_API_KEY=...

# Optional: better/faster voices via eleven_flash_v2_5.
# Get one at https://elevenlabs.io  -> set providers.tts: elevenlabs
# ELEVENLABS_API_KEY=...

# Optional: point at an OpenAI-compatible gateway (LM Studio, vLLM, LiteLLM, ...).
# OPENAI_BASE_URL=http://localhost:1234/v1
