# copy this to .env and fill it in. .env is in .gitignore so it wont get
# committed. REPLACE the sk-... below, don't just copy the file and run it,
# the app will tell you off but still

# this one key does the speech recognition, the translating and the voice
OPENAI_API_KEY=sk-...

# optional, better translations between european languages.
# free tier is 500k characters a month which is loads.
# https://www.deepl.com/pro-api    then set providers.translation: deepl
# DEEPL_API_KEY=...

# optional, nicer and faster voices
# https://elevenlabs.io    then set providers.tts: elevenlabs
# ELEVENLABS_API_KEY=...

# optional, if you're running something openai compatible locally
# (LM Studio, vLLM, LiteLLM etc)
# OPENAI_BASE_URL=http://localhost:1234/v1
